# Pseudo TikTok du live (sans @). Vide = mode simulation.
TIKTOK_USERNAME=
# Plages où le lien TikTok s'active tout seul (PC allumé en permanence). Vide = tout le temps.
# Exemple : midi-14h, 18h-23h30
SCHEDULE=12:00-14:00,18:00-23:30
# 3030 par défaut (3000 est souvent pris, par Grafana par exemple)
PORT=3030
# 127.0.0.1 = accessible seulement depuis ce PC
HOST=127.0.0.1

# Clé Euler Stream (facultative) : seulement si la connexion TikTok échoue à cause des limites gratuites
TIKTOK_SIGN_API_KEY=

# Ordre des IA : Gemma local (Ollama) -> Groq -> phrases pré-écrites
# Sans IA joignable, Maxima ne dit que des phrases pré-écrites. Si Gemma met plus de 2 s, Groq est lancé en parallèle.
LLM_ORDER=ollama,groq
OLLAMA_URL=http://127.0.0.1:11434
# Tag exact du modèle Gemma installé (voir `ollama list`)
OLLAMA_MODEL=gemma4:e4b
# PC sans carte graphique : gemma4:e2b (2x plus rapide) et délais allongés pour laisser Gemma parler en premier :
# OLLAMA_MODEL=gemma4:e2b
# AI_HEDGE_MS=8000        (Groq lancé en renfort après 8 s ; défaut 2000)
# AI_NARRATE_MS=10000     (phrase pré-écrite après 10 s ; défaut 3500)
# AI_REPLY_MS=14000       (réponse au chat ; défaut 7000)
# OLLAMA_TIMEOUT_MS=15000 (défaut 8000)
# OLLAMA_THREADS=6        (cœurs laissés à Gemma ; 0 = tous)
# Clé gratuite sur https://console.groq.com (laisser vide pour désactiver)
GROQ_API_KEY=
# openai/gpt-oss-120b (rapide, pas cher) ; aussi : openai/gpt-oss-20b, qwen/qwen3.8-27b. (llama-3.3-70b-versatile n'existe plus)
GROQ_MODEL=openai/gpt-oss-120b

# Jeu
LOBBY_SECONDS=45
START_HP=100
SHOW_AVATARS=1
